<mxfile host="app.diagrams.net" modified="2026-10-27T00:00:00.000Z" agent="Go2 project" version="24.7.17" type="device">
  <diagram id="go2-edge-cloud" name="System Architecture">
    <mxGraphModel dx="1480" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Cost-aware edge-cloud mapping for Unitree Go2" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=28;fontStyle=1;fontColor=#173042;" vertex="1" parent="1"><mxGeometry x="50" y="35" width="900" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Preview traffic stays responsive; verified sensor records remain available for reconstruction." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=15;fontColor=#536b78;" vertex="1" parent="1"><mxGeometry x="50" y="82" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="sensors" value="&lt;b&gt;Go2 sensors&lt;/b&gt;&lt;br&gt;&lt;br&gt;LiDAR · IMU&lt;br&gt;RGB-D camera&lt;br&gt;Native DDS topics&lt;br&gt;Local raw recording" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF5F3;strokeColor=#35A99C;fontColor=#173042;fontSize=16;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="230" height="230" as="geometry"/></mxCell>
        <mxCell id="edge" value="&lt;b&gt;Edge capture &amp;amp; scheduling&lt;/b&gt;&lt;br&gt;&lt;br&gt;ROS 2 adapters · sealed segments&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#188F83&quot;&gt;Priority: live preview + health&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#456FAE&quot;&gt;Durable: resumable sensor records&lt;/font&gt;&lt;br&gt;&lt;br&gt;Bulk transfer uses remaining measured capacity." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F0F6F8;strokeColor=#6C91A1;fontColor=#173042;fontSize=15;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="190" width="320" height="230" as="geometry"/></mxCell>
        <mxCell id="link" value="&lt;b&gt;Measured link&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tailnet transport&lt;br&gt;ACK-based capacity&lt;br&gt;Checksum-verified chunks&lt;br&gt;Retry and resume" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF2FA;strokeColor=#6C86B4;fontColor=#173042;fontSize=15;spacing=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="220" width="205" height="170" as="geometry"/></mxCell>
        <mxCell id="mapping" value="&lt;b&gt;PC mapping stack&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Ingest LiDAR + LIO&lt;br&gt;2. Fuse observations into submaps&lt;br&gt;3. Reconstruct and assess surfaces&lt;br&gt;4. Publish artifacts and quality state&lt;br&gt;&lt;br&gt;Calibration, frame, time, and source provenance travel with data." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF4F4;strokeColor=#39A59B;fontColor=#173042;fontSize=15;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="955" y="190" width="460" height="230" as="geometry"/></mxCell>
        <mxCell id="dashboard" value="&lt;b&gt;Operator dashboard&lt;/b&gt;&lt;br&gt;Map ? health ? mission state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7F8;strokeColor=#9AB0BA;fontColor=#173042;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="520" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="nav2" value="&lt;b&gt;Nav2 mission bridge&lt;/b&gt;&lt;br&gt;Coarse-map tasks become goals" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F7F8;strokeColor=#9AB0BA;fontColor=#173042;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="vla" value="&lt;b&gt;MobileVLA intent adapter&lt;/b&gt;&lt;br&gt;High-level intent only; no motor commands" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDF3FB;strokeColor=#7998C6;fontColor=#173042;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="710" y="520" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="gate" value="&lt;b&gt;Terrain request gate&lt;/b&gt;&lt;br&gt;Fresh terrain + health + operator approval&lt;br&gt;Policy replay is separate from actuation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3E2;strokeColor=#C88C49;fontColor=#49351E;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1040" y="520" width="375" height="105" as="geometry"/></mxCell>
