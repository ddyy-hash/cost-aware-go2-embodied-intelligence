        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6481B0;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="mapping" target="vla"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="500"/><mxPoint x="860" y="500"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C88C49;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#8D642F;" edge="1" parent="1" source="vla" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="foot" value="Evidence supports software checks, offline replay, and simulation. Hardware motion requires separate operator authorization." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=13;fontColor=#536b78;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="1200" height="30" as="geometry"/></mxCell>
