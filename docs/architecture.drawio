        <mxCell id="e4" value="verified map" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#647F8D;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#536b78;" edge="1" parent="1" source="mapping" target="dashboard"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="470"/><mxPoint x="200" y="470"/></Array></mxGeometry></mxCell>
